#!/bin/sh
xset s off; xset -dpms; xset s noblank
unclutter -idle 1 &
openbox &
sleep 1
# monitors left to right, as WIDTHxHEIGHT+X+Y
GEOS=$(xrandr --query 2>/dev/null | grep ' connected' | grep -o '[0-9]\+x[0-9]\+[+][0-9]\+[+][0-9]\+' | sort -t+ -k2 -n)
N=$(printf '%s\n' "$GEOS" | grep -c .)
open_on() { # monitor number, page
  g=$(printf '%s\n' "$GEOS" | sed -n "${1}p")
  if [ -n "$g" ]; then W=${g%%x*}; r=${g#*x}; H=${r%%+*}; r=${r#*+}; X=${r%%+*}; Y=${r#*+}; POS="--window-position=$X,$Y --window-size=$W,$H"; else POS=""; fi
  ( while true; do
      chromium --kiosk --incognito --no-first-run --noerrdialogs --disable-infobars --disable-translate --disable-features=Translate,TranslateUI --lang=nl --allow-file-access-from-files --no-sandbox --disable-gpu --disable-dev-shm-usage \
        --autoplay-policy=no-user-gesture-required --user-data-dir=/tmp/door-browser-$1 $POS "file:///opt/saga-door/loading.html?to=$2"
      sleep 2
    done ) &
}
if [ "$N" -ge 2 ]; then
  open_on 1 "/start"            # first monitor: addresses and the control panel
  open_on 2 "/%3Fkiosk%3D1"     # second monitor: the door screen
else
  open_on 1 "/start%3Fnext%3Ddoor"   # one monitor: addresses first, then the door screen
fi
wait
